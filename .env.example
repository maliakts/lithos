# Telegram botu için @BotFather'dan alınan token (boş bırakırsan Telegram kapalı çalışır)
TELEGRAM_BOT_TOKEN=
# Yeni depremlerin otomatik gönderileceği kanal: @kanal_adi veya -100... numarası (bot kanalda yönetici olmalı)
TELEGRAM_CHANNEL=
# Kanala gönderilecek en küçük büyüklük
CHANNEL_MIN_MAG=2.5
PORT=3000
# Kaynaklara kaç saniyede bir sorulsun (en az 15)
POLL_SECONDS=60

# Telegram'a doğrudan ulaşılamıyorsa (ağ engeli) Cloudflare Worker adresin, örn: lithos-tg.kullanici.workers.dev
# TELEGRAM_API_HOST=
